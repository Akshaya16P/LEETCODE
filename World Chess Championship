import java.util.*;

class Codechef {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int T = sc.nextInt();

        while (T-- > 0) {
            int X = sc.nextInt();
            String S = sc.next();

            int carlsenScore = 0;

            for (int i = 0; i < S.length(); i++) {
                char ch = S.charAt(i);

                if (ch == 'C') {
                    carlsenScore += 2;
                } 
                else if (ch == 'D') {
                    carlsenScore += 1;
                }
            }

            int chefScore = 28 - carlsenScore;

            if (carlsenScore > chefScore) {
                System.out.println(60 * X);
            } 
            else if (carlsenScore == chefScore) {
                System.out.println(55 * X);
            } 
            else {
                System.out.println(40 * X);
            }
        }

        sc.close();
    }
}
